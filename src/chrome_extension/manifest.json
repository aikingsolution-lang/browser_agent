
{
  "manifest_version": 3,
  "name": "Browser Agent Connector",
  "version": "0.2.0",
  "description": "AI browser automation through Chrome",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  }
}
